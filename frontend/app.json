{
  "expo": {
    "name": "MSTConnect",
    "slug": "mstconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mstconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mstc.mstconnect"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0c"
      },
      "package": "com.mstc.mstconnect",
      "usesCleartextTraffic": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0c",
          "dark": {
            "backgroundColor": "#0a0a0c",
            "image": "./assets/images/splash-image.png"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0a0a0c"
  }
}